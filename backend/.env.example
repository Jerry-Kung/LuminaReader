# LLM 服务（必填）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# LLM 调用参数（可选）
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_RETURN_RAW=false

# V1.1.0 F2：thinking 推理开关兜底（仅当 user_data/settings.json 不存在或不含 thinking 段时生效）。
# 仅 Qwen 兼容接口的推理型模型支持；其他 Provider 静默回落。
THINKING_ENABLED=false

# 服务参数（可选）
HOST=127.0.0.1
PORT=18086
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000
